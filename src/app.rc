#pragma code_page(65001)

#include <winresrc.h>
#include "resource.h"

IDR_MAINFRAME ICON "../assets/HotkeyBlocker.ico"

STRINGTABLE
BEGIN
    IDR_MAINFRAME "Hotkey Blocker"
END

IDD_MAIN_VIEW DIALOGEX 0, 0, 440, 270
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_VISIBLE | WS_CLIPCHILDREN
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    CONTROL         "", IDC_APP_LIST, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 8, 8, 424, 254
END

IDR_MAINFRAME MENU
BEGIN
    POPUP "文件(&F)"
    BEGIN
        MENUITEM "添加 EXE...\tCtrl+O", ID_MAIN_ADD_EXECUTABLE
        MENUITEM "添加文件夹...\tCtrl+Shift+O", ID_MAIN_ADD_FOLDER
    END
    POPUP "选项(&O)"
    BEGIN
        MENUITEM "登录时启动", ID_MAIN_AUTOSTART
    END
    POPUP "帮助(&H)"
    BEGIN
        MENUITEM "检查更新...", ID_TRAY_CHECK_UPDATES
    END
END

IDR_MAINFRAME ACCELERATORS
BEGIN
    "O", ID_MAIN_ADD_EXECUTABLE, VIRTKEY, CONTROL
    "O", ID_MAIN_ADD_FOLDER, VIRTKEY, CONTROL, SHIFT
END

IDR_APP_LIST_CONTEXT_MENU MENU
BEGIN
    POPUP "规则"
    BEGIN
        MENUITEM "配置...", ID_APP_LIST_CONFIGURE
        MENUITEM "删除...", ID_APP_LIST_DELETE
    END
END

IDD_HOTKEY_POLICY_DIALOG DIALOGEX 0, 0, 280, 205
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "规则配置"
FONT 9, "Segoe UI"
BEGIN
    AUTOCHECKBOX    "启用此规则", IDC_RULE_ENABLED, 8, 8, 90, 12
    LTEXT           "更改启停状态后，须重启目标应用方可生效。", IDC_STATIC, 8, 23, 264, 12
    LTEXT           "拦截模式:", IDC_STATIC, 8, 43, 56, 12
    COMBOBOX        IDC_HOTKEY_MODE, 70, 41, 202, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "快捷键列表:", IDC_STATIC, 8, 64, 72, 12
    LISTBOX         IDC_HOTKEY_LIST, 8, 76, 264, 68, LBS_NOINTEGRALHEIGHT | WS_BORDER | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Tab 切换焦点，Enter 确定，Esc 取消，Alt+F4 关闭", IDC_STATIC, 8, 150, 264, 12
    EDITTEXT        IDC_HOTKEY_CAPTURE, 8, 162, 164, 14, ES_READONLY | WS_TABSTOP
    PUSHBUTTON      "添加", IDC_HOTKEY_ADD, 178, 162, 94, 14
    PUSHBUTTON      "删除", IDC_HOTKEY_REMOVE, 8, 183, 60, 14
    DEFPUSHBUTTON   "确定", IDOK, 156, 183, 54, 14
    PUSHBUTTON      "取消", IDCANCEL, 216, 183, 56, 14
END

IDR_TRAY_MENU MENU
BEGIN
    POPUP "Tray"
    BEGIN
        MENUITEM "显示窗口", ID_TRAY_SHOW
        MENUITEM "检查更新", ID_TRAY_CHECK_UPDATES
        MENUITEM SEPARATOR
        MENUITEM "退出", ID_TRAY_EXIT
    END
END

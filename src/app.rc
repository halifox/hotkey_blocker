#pragma code_page(65001)

#include <winresrc.h>
#include "resource.h"

IDD_MAIN_WINDOW DIALOGEX 0, 0, 880, 250
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_THICKFRAME
EXSTYLE WS_EX_APPWINDOW
CAPTION "Hotkey Blocker"
FONT 10, "Segoe UI"
BEGIN
    CONTROL         "", IDC_APP_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP, 8, 8, 864, 196
    PUSHBUTTON      "添加应用", IDC_ADD_APP, 8, 214, 85, 18
    PUSHBUTTON      "删除", IDC_DELETE_APP, 100, 214, 65, 18
    PUSHBUTTON      "启用/停用", IDC_TOGGLE_APP, 172, 214, 85, 18
    AUTOCHECKBOX    "登录时启动", IDC_AUTOSTART, 275, 216, 90, 14
END

IDR_TRAY_MENU MENU
BEGIN
    POPUP "Tray"
    BEGIN
        MENUITEM "显示窗口", ID_TRAY_SHOW
        MENUITEM SEPARATOR
        MENUITEM "退出", ID_TRAY_EXIT
    END
END

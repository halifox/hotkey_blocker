#pragma code_page(65001)

#include <winresrc.h>
#include "resource.h"

IDD_MAIN_WINDOW DIALOGEX 0, 0, 320, 231
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "Hotkey Blocker"
FONT 9, "Segoe UI"
BEGIN
    CONTROL         "", IDC_APP_LIST, "SysListView32", LVS_REPORT | WS_BORDER | WS_TABSTOP, 8, 8, 304, 195
    PUSHBUTTON      "添加 EXE", IDC_ADD_EXECUTABLE, 8, 211, 48, 12
    PUSHBUTTON      "添加文件夹", IDC_ADD_FOLDER, 60, 211, 48, 12
    PUSHBUTTON      "删除", IDC_DELETE_APP, 112, 211, 48, 12
    PUSHBUTTON      "启用/停用", IDC_TOGGLE_APP, 164, 211, 48, 12
    AUTOCHECKBOX    "登录时启动", IDC_AUTOSTART, 216, 211, 48, 12
END

IDR_TRAY_MENU MENU
BEGIN
    POPUP "Tray"
    BEGIN
        MENUITEM "显示窗口", ID_TRAY_SHOW
        MENUITEM SEPARATOR
        MENUITEM "退出", ID_TRAY_EXIT
    END
END

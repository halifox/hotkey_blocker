#pragma code_page(65001)

#include <winresrc.h>
#include "resource.h"

IDI_APP_ICON ICON "../assets/HotkeyBlocker.ico"

IDD_MAIN_WINDOW DIALOGEX 0, 0, 320, 231
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "Hotkey Blocker"
FONT 9, "Segoe UI"
BEGIN
    CONTROL         "", IDC_APP_LIST, "SysListView32", LVS_REPORT | LVS_NOSCROLL | WS_BORDER | WS_TABSTOP, 8, 8, 304, 195
    PUSHBUTTON      "添加 EXE", IDC_ADD_EXECUTABLE, 8, 205, 48, 12
    PUSHBUTTON      "添加文件夹", IDC_ADD_FOLDER, 60, 205, 48, 12
    PUSHBUTTON      "配置", IDC_CONFIGURE_HOTKEY, 112, 205, 48, 12
    PUSHBUTTON      "删除", IDC_DELETE_APP, 164, 205, 48, 12
    PUSHBUTTON      "启用/停用", IDC_TOGGLE_APP, 216, 205, 48, 12
    AUTOCHECKBOX    "登录时启动", IDC_AUTOSTART, 268, 205, 48, 12
    LTEXT           "启用或停用规则后，须重启目标应用，快捷键拦截设置方可生效。", IDC_HELP_TEXT, 8, 220, 304, 12
END

IDD_HOTKEY_POLICY_DIALOG DIALOGEX 0, 0, 240, 170
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "快捷键策略"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "拦截模式:", IDC_STATIC, 8, 8, 56, 12
    COMBOBOX        IDC_HOTKEY_MODE, 70, 6, 162, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "快捷键列表:", IDC_STATIC, 8, 28, 56, 12
    LISTBOX         IDC_HOTKEY_LIST, 8, 40, 224, 75, LBS_NOINTEGRALHEIGHT | WS_BORDER | WS_VSCROLL | WS_TABSTOP
    LTEXT           "按下组合键:", IDC_STATIC, 8, 120, 64, 12
    EDITTEXT        IDC_HOTKEY_CAPTURE, 8, 132, 160, 14, ES_READONLY | WS_TABSTOP
    PUSHBUTTON      "添加", IDC_HOTKEY_ADD, 172, 132, 60, 14
    PUSHBUTTON      "删除", IDC_HOTKEY_REMOVE, 8, 150, 60, 14
    DEFPUSHBUTTON   "确定", IDOK, 116, 150, 54, 14
    PUSHBUTTON      "取消", IDCANCEL, 178, 150, 54, 14
END

IDD_ABOUT_DIALOG DIALOGEX 0, 0, 250, 104
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "关于 Hotkey Blocker"
FONT 9, "Segoe UI"
BEGIN
    ICON            IDI_APP_ICON, IDC_STATIC, 8, 8, 32, 32
    LTEXT           "Hotkey Blocker", IDC_STATIC, 48, 8, 190, 14
    LTEXT           "", IDC_ABOUT_VERSION, 48, 26, 190, 12
    LTEXT           "用于拦截应用注册全局快捷键。", IDC_STATIC, 8, 48, 234, 12
    LTEXT           "可通过 GitHub Release 检查最新版本。", IDC_ABOUT_STATUS, 8, 62, 234, 12
    PUSHBUTTON      "检查更新", IDC_ABOUT_CHECK_UPDATES, 8, 82, 72, 14
    DEFPUSHBUTTON   "关闭", IDCANCEL, 182, 82, 60, 14
END

IDR_TRAY_MENU MENU
BEGIN
    POPUP "Tray"
    BEGIN
        MENUITEM "显示窗口", ID_TRAY_SHOW
        MENUITEM "关于", ID_TRAY_ABOUT
        MENUITEM "检查更新", ID_TRAY_CHECK_UPDATES
        MENUITEM SEPARATOR
        MENUITEM "退出", ID_TRAY_EXIT
    END
END

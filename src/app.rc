#pragma code_page(65001)

#include <winresrc.h>
#include "resource.h"

IDD_MAIN_WINDOW DIALOGEX 0, 0, 320, 231
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "Hotkey Blocker"
FONT 9, "Segoe UI"
BEGIN
    CONTROL         "", IDC_APP_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP, 8, 8, 304, 193
    PUSHBUTTON      "添加应用", IDC_ADD_APP, 8, 209, 56, 14
    PUSHBUTTON      "删除", IDC_DELETE_APP, 70, 209, 40, 14
    PUSHBUTTON      "启用/停用", IDC_TOGGLE_APP, 116, 209, 64, 14
    AUTOCHECKBOX    "登录时启动", IDC_AUTOSTART, 188, 209, 90, 14
END

IDR_TRAY_MENU MENU
BEGIN
    POPUP "Tray"
    BEGIN
        MENUITEM "显示窗口", ID_TRAY_SHOW
        MENUITEM SEPARATOR
        MENUITEM "退出", ID_TRAY_EXIT
    END
END
